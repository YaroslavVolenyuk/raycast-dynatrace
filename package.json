{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dynatrace",
  "title": "Dynatrace Connector",
  "description": "Search logs and traces in Dynatrace Grail and manage multiple tenants — without leaving your keyboard.",
  "icon": "dynatrace-icon.png",
  "author": "yaroslav_volenyuk",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "keywords": [
    "dt",
    "dynatrace",
    "observability",
    "logs",
    "monitoring",
    "apm",
    "dql",
    "grail"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "dt-manage-tenants",
      "title": "Manage Tenants",
      "subtitle": "Dynatrace",
      "description": "Add, edit, test, and switch between Dynatrace tenants",
      "mode": "view",
      "icon": "dynatrace-icon.png"
    },
    {
      "name": "dt-search-logs",
      "title": "Search Logs",
      "subtitle": "Dynatrace",
      "description": "Search Dynatrace Grail logs with DQL filters",
      "mode": "view",
      "icon": "dynatrace-icon.png",
      "arguments": [
        {
          "name": "timeframe",
          "type": "dropdown",
          "placeholder": "Last 24h",
          "data": [
            {
              "title": "Last 15 min",
              "value": "15m"
            },
            {
              "title": "Last 30 min",
              "value": "30m"
            },
            {
              "title": "Last 1h",
              "value": "1h"
            },
            {
              "title": "Last 6h",
              "value": "6h"
            },
            {
              "title": "Last 24h",
              "value": "24h"
            },
            {
              "title": "Last 3d",
              "value": "3d"
            },
            {
              "title": "Last 7d",
              "value": "7d"
            }
          ],
          "required": false
        },
        {
          "name": "query",
          "type": "dropdown",
          "placeholder": "All Logs",
          "data": [
            {
              "title": "All Logs",
              "value": "all"
            },
            {
              "title": "Error",
              "value": "error"
            },
            {
              "title": "Warn",
              "value": "warn"
            },
            {
              "title": "Info",
              "value": "info"
            },
            {
              "title": "None",
              "value": "none"
            }
          ],
          "required": false
        },
        {
          "name": "limit",
          "type": "dropdown",
          "placeholder": "100",
          "data": [
            {
              "title": "50",
              "value": "50"
            },
            {
              "title": "100",
              "value": "100"
            },
            {
              "title": "250",
              "value": "250"
            },
            {
              "title": "500",
              "value": "500"
            }
          ],
          "required": false
        }
      ]
    },
    {
      "name": "dt-search-traces",
      "title": "Search Traces",
      "subtitle": "Dynatrace",
      "description": "Search distributed traces and spans in Dynatrace Grail",
      "mode": "view",
      "icon": "dynatrace-icon.png",
      "arguments": [
        {
          "name": "timeframe",
          "type": "dropdown",
          "placeholder": "Last 24h",
          "data": [
            { "title": "Last 15 min", "value": "15m" },
            { "title": "Last 30 min", "value": "30m" },
            { "title": "Last 1h",     "value": "1h"  },
            { "title": "Last 6h",     "value": "6h"  },
            { "title": "Last 24h",    "value": "24h" },
            { "title": "Last 3d",     "value": "3d"  },
            { "title": "Last 7d",     "value": "7d"  }
          ],
          "required": false
        },
        {
          "name": "traceId",
          "type": "text",
          "placeholder": "Trace ID (optional)",
          "required": false
        }
      ]
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "22.13.10",
    "@types/react": "^19.2.17",
    "eslint": "9.22.0",
    "jest": "30.4.1",
    "knip": "5.61.3",
    "prettier": "3.5.3",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "eslint src",
    "fix-lint": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "knip": "knip"
  }
}
