{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-dynatrace",
  "title": "Dynatrace",
  "description": "Monitor your Dynatrace environment directly from Raycast — logs, problems, DQL, deployments and entities.",
  "icon": "dynatrace-icon.png",
  "author": "yaroslav_volenyuk",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "keywords": [
    "dynatrace",
    "observability",
    "logs",
    "monitoring",
    "apm",
    "dql",
    "grail"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "useMockData",
      "title": "Use Mock Data",
      "description": "Use fixture-backed mock data instead of the real Dynatrace API (for development)",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Enable mock mode"
    }
  ],
  "commands": [
    {
      "name": "dt-search-logs",
      "title": "Search Logs",
      "subtitle": "Dynatrace",
      "description": "Search Dynatrace Grail logs with DQL filters",
      "mode": "view",
      "icon": "dynatrace-icon.png",
      "arguments": [
        {
          "name": "timeframeValue",
          "type": "text",
          "placeholder": "24",
          "required": false
        },
        {
          "name": "timeframeUnit",
          "type": "dropdown",
          "placeholder": "Hours",
          "data": [
            { "title": "Minutes", "value": "m" },
            { "title": "Hours", "value": "h" },
            { "title": "Days", "value": "d" }
          ],
          "required": false
        },
        {
          "name": "query",
          "type": "dropdown",
          "placeholder": "All Logs",
          "data": [
            { "title": "All Logs", "value": "all" },
            { "title": "Error", "value": "error" },
            { "title": "Fatal", "value": "fatal" },
            { "title": "Warning", "value": "warning" },
            { "title": "Info", "value": "info" },
            { "title": "Debug", "value": "debug" }
          ],
          "required": false
        }
      ]
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@raycast/api": "^1.85.2",
    "@raycast/utils": "^1.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "22.13.10",
    "@types/react": "^19.2.17",
    "eslint": "^9.22.0",
    "jest": "30.4.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "eslint src",
    "fix-lint": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  }
}
