{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "connector-for-dynatrace",
  "title": "Connector for Dynatrace",
  "description": "Run DQL, search logs and traces, and watch open Davis problems in the menu bar — across multiple Dynatrace tenants.",
  "icon": "icon.png",
  "author": "yaroslav_volenyuk",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "keywords": [
    "dt",
    "dynatrace",
    "observability",
    "logs",
    "monitoring",
    "apm",
    "dql",
    "grail"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "refreshMinutes",
      "type": "dropdown",
      "title": "Problems in Menu Bar: Refresh Interval",
      "description": "How often the menu bar queries Dynatrace. Each refresh is a billable DQL query.",
      "required": false,
      "default": "30",
      "data": [
        {
          "title": "Every 15 minutes",
          "value": "15"
        },
        {
          "title": "Every 30 minutes",
          "value": "30"
        },
        {
          "title": "Every hour",
          "value": "60"
        },
        {
          "title": "Every 3 hours",
          "value": "180"
        },
        {
          "title": "Every 6 hours",
          "value": "360"
        },
        {
          "title": "Every 12 hours",
          "value": "720"
        }
      ]
    },
    {
      "name": "lookback",
      "type": "dropdown",
      "title": "Problems in Menu Bar: Look-back Window",
      "description": "Only problems that were updated within this window are checked. Longer windows scan more data.",
      "required": false,
      "default": "7d",
      "data": [
        {
          "title": "Last 24 hours",
          "value": "1d"
        },
        {
          "title": "Last 7 days",
          "value": "7d"
        },
        {
          "title": "Last 30 days",
          "value": "30d"
        }
      ]
    },
    {
      "name": "extraFilter",
      "type": "textfield",
      "title": "Problems in Menu Bar: Extra DQL Filter",
      "description": "Optional. A DQL filter expression added to the query, e.g. event.category == \"ERROR\". Do not include 'filter' or '|' (a '|' inside a string literal is rejected too).",
      "required": false,
      "placeholder": "event.category == \"ERROR\""
    }
  ],
  "commands": [
    {
      "name": "dt-manage-tenants",
      "title": "Manage Tenants",
      "subtitle": "Dynatrace",
      "description": "Add, edit, test, and switch between Dynatrace tenants, each with a platform token or an OAuth client",
      "mode": "view",
      "icon": "icon.png"
    },
    {
      "name": "dt-search-logs",
      "title": "Search Logs",
      "subtitle": "Dynatrace",
      "description": "Search Dynatrace Grail logs with DQL filters",
      "mode": "view",
      "icon": "icon.png",
      "arguments": [
        {
          "name": "timeframe",
          "type": "dropdown",
          "placeholder": "Last 24h",
          "data": [
            {
              "title": "Last 15 min",
              "value": "15m"
            },
            {
              "title": "Last 30 min",
              "value": "30m"
            },
            {
              "title": "Last 1h",
              "value": "1h"
            },
            {
              "title": "Last 6h",
              "value": "6h"
            },
            {
              "title": "Last 24h",
              "value": "24h"
            },
            {
              "title": "Last 3d",
              "value": "3d"
            },
            {
              "title": "Last 7d",
              "value": "7d"
            }
          ],
          "required": false
        },
        {
          "name": "query",
          "type": "dropdown",
          "placeholder": "All Logs",
          "data": [
            {
              "title": "All Logs",
              "value": "all"
            },
            {
              "title": "Error",
              "value": "error"
            },
            {
              "title": "Warn",
              "value": "warn"
            },
            {
              "title": "Info",
              "value": "info"
            },
            {
              "title": "None",
              "value": "none"
            }
          ],
          "required": false
        },
        {
          "name": "limit",
          "type": "dropdown",
          "placeholder": "Limit: 100",
          "data": [
            {
              "title": "Limit: 50",
              "value": "50"
            },
            {
              "title": "Limit: 100",
              "value": "100"
            },
            {
              "title": "Limit: 250",
              "value": "250"
            },
            {
              "title": "Limit: 500",
              "value": "500"
            }
          ],
          "required": false
        }
      ]
    },
    {
      "name": "dt-search-traces",
      "title": "Search Traces",
      "subtitle": "Dynatrace",
      "description": "Search distributed traces and spans in Dynatrace Grail",
      "mode": "view",
      "icon": "icon.png",
      "arguments": [
        {
          "name": "timeframe",
          "type": "dropdown",
          "placeholder": "Last 24h",
          "data": [
            {
              "title": "Last 15 min",
              "value": "15m"
            },
            {
              "title": "Last 30 min",
              "value": "30m"
            },
            {
              "title": "Last 1h",
              "value": "1h"
            },
            {
              "title": "Last 6h",
              "value": "6h"
            },
            {
              "title": "Last 24h",
              "value": "24h"
            },
            {
              "title": "Last 3d",
              "value": "3d"
            },
            {
              "title": "Last 7d",
              "value": "7d"
            }
          ],
          "required": false
        },
        {
          "name": "traceId",
          "type": "text",
          "placeholder": "Trace ID (optional)",
          "required": false
        }
      ]
    },
    {
      "name": "dt-run-dql",
      "title": "Run DQL",
      "subtitle": "Dynatrace",
      "description": "Run any DQL query against Grail and browse, filter and copy the results",
      "mode": "view",
      "icon": "icon.png"
    },
    {
      "name": "dt-menubar-problems",
      "title": "Problems in Menu Bar",
      "subtitle": "Dynatrace",
      "description": "Show the number of open Dynatrace problems in the macOS menu bar",
      "mode": "menu-bar",
      "icon": "icon.png",
      "interval": "15m",
      "platforms": [
        "macOS"
      ]
    },
    {
      "name": "dt-refresh-problems",
      "title": "Refresh Problems",
      "subtitle": "Dynatrace",
      "description": "Fetch open Dynatrace problems now and update Problems in Menu Bar",
      "mode": "no-view",
      "icon": "icon.png",
      "platforms": [
        "macOS"
      ]
    }
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@raycast/api": "^2.9.0",
    "@raycast/utils": "^2.2.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "2.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "22.13.10",
    "@types/react": "^19.2.17",
    "eslint": "9.22.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "jest": "30.4.1",
    "knip": "5.61.3",
    "lint-staged": "17.6.0",
    "prettier": "3.5.3",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "eslint src",
    "fix-lint": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "knip": "knip",
    "prepare": "husky"
  }
}
